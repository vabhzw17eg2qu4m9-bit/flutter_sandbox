#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  QUALITY GATE — DO NOT LOWER THESE THRESHOLDS WITHOUT TEAM APPROVAL       ║
# ║  Every commit must pass: file size, analyze, tests, coverage ≥ 80%,       ║
# ║  CRAP ratchet (crap4dart.yaml), duplication < 1.4%.                       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Pre-commit hook for flutter_sandbox (pure Dart package).
# Canonical copy: scripts/pre-commit — install with:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# To skip (emergency only): git commit --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Unset git env vars so test processes that spawn git subprocesses use the
# correct working directory rather than the hook's environment.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE 2>/dev/null || true

COVERAGE_BASELINE=80.0
DUP_THRESHOLD=1.4
# Baseline at extraction 1.39% — clones live in verbatim-ported upstream
# files; ratchet only-down.
MAX_LINES=2800

# ═══════════════════════════════════════════════════════════════════════════
# 1. FILE SIZE GUARD
# ═══════════════════════════════════════════════════════════════════════════
VIOLATIONS=()
while IFS= read -r file; do
  case "$file" in
    *.dart)
      case "$file" in
        *.g.dart) continue ;;
      esac
      lines=$(wc -l < "$file")
      if (( lines > MAX_LINES )); then
        VIOLATIONS+=("  $file: $lines lines (max $MAX_LINES)")
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if ((${#VIOLATIONS[@]} > 0)); then
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════════════════╗"
  echo "║  ❌ QUALITY GATE FAILED — FILE SIZE                                       ║"
  echo "╚═══════════════════════════════════════════════════════════════════════════╝"
  printf '%s\n' "${VIOLATIONS[@]}"
  exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# 2. STATIC ANALYSIS
# ═══════════════════════════════════════════════════════════════════════════
echo "🔍 Running dart analyze..."
dart analyze

echo "🎨 Auto-formatting staged Dart files..."
# Format is SELF-HEALING with a BLOCKING backstop: reformat exactly the
# Dart files in the index and re-stage them; anything still unformatted
# after that (formatter crashed on syntax errors) blocks the commit with a
# clear message. A whole-tree `--set-exit-if-changed` gate both (a) failed
# commits over a single unformatted line and (b) rewrote OTHER agents'
# work-in-progress files mid-edit when run concurrently — scoped auto-fix
# avoids both.
STAGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)
if [ -n "$STAGED_DART" ]; then
  printf '%s\n' "$STAGED_DART" | xargs dart format >/dev/null 2>&1 || true
  printf '%s\n' "$STAGED_DART" | xargs git add --
  UNFORMATTED=$(dart format --output=none --set-exit-if-changed $STAGED_DART 2>/dev/null | grep '^Changed' || true)
  if [ -n "$UNFORMATTED" ]; then
    echo "❌ dart format could not fix these files (syntax error?):"
    echo "$UNFORMATTED"
    exit 1
  fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# 3. TESTS WITH COVERAGE
# ═══════════════════════════════════════════════════════════════════════════
# Integration-tagged tests exercise real OS sandbox backends and are too
# slow/environment-dependent for a pre-commit gate; they run in CI /
# manually instead (see dart_test.yaml).
echo "🧪 Running dart test --coverage (excluding integration tests)..."
rm -rf coverage
dart test --coverage=coverage --exclude-tags integration

echo "📊 Formatting coverage to lcov..."
dart run coverage:format_coverage --lcov -i coverage -o coverage/lcov.info

# ═══════════════════════════════════════════════════════════════════════════
# 4. COVERAGE RATCHET (lib/ only)
# ═══════════════════════════════════════════════════════════════════════════
echo "🔍 Checking line coverage (baseline: >= ${COVERAGE_BASELINE}%)..."
if python3 scripts/check_coverage.py "$COVERAGE_BASELINE"; then
  echo "✅ Coverage gate OK"
else
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════════════════╗"
  echo "║  ❌ QUALITY GATE FAILED — TEST COVERAGE                                   ║"
  echo "╚═══════════════════════════════════════════════════════════════════════════╝"
  echo "   Add tests for uncovered code, then retry."
  exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# 5. CRAP RATCHET (complexity × coverage; threshold pinned in crap4dart.yaml)
# ═══════════════════════════════════════════════════════════════════════════
if command -v dart >/dev/null 2>&1 && \
   dart pub global run crap4dart --version >/dev/null 2>&1; then
  echo "🔍 Checking CRAP scores (ratchet: only down from the pinned max)..."
  # Reuses the fresh coverage/lcov.info produced above.
  if dart pub global run crap4dart analyze; then
    echo "✅ CRAP gate OK"
  else
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════════════════╗"
    echo "║  ❌ QUALITY GATE FAILED — CRAP RATCHET                                    ║"
    echo "╚═══════════════════════════════════════════════════════════════════════════╝"
    echo "   A method's CRAP score exceeded the pinned max in crap4dart.yaml."
    echo "   Simplify it or add tests — the threshold only goes DOWN."
    exit 1
  fi
else
  echo "⚠️  crap4dart not activated (dart pub global activate crap4dart 0.2.1) — skipping CRAP gate"
fi

# ═══════════════════════════════════════════════════════════════════════════
# 6. CODE DUPLICATION GUARD
# ═══════════════════════════════════════════════════════════════════════════
if command -v jscpd >/dev/null 2>&1; then
  echo "🔍 Checking code duplication (threshold: lib/ < ${DUP_THRESHOLD}%)..."
  dup_pct() {
    jscpd --min-tokens 50 --min-lines 5 --reporters json --output "$2" "$1" >/dev/null 2>&1 || true
    python3 -c "
import json
try:
    with open('$2/jscpd-report.json') as f:
        d=json.load(f)
    print(d['statistics']['total']['percentage'])
except Exception:
    print('0.0')
" 2>/dev/null || echo "0.0"
  }
  LIB_DUP=$(dup_pct lib/ /tmp/jscpd-precommit-lib)
  if python3 -c "exit(0 if float('$LIB_DUP') < float('$DUP_THRESHOLD') else 1)"; then
    echo "✅ Duplication check OK ($LIB_DUP% < ${DUP_THRESHOLD}%)"
  else
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════════════════╗"
    echo "║  ❌ QUALITY GATE FAILED — CODE DUPLICATION                                ║"
    echo "╚═══════════════════════════════════════════════════════════════════════════╝"
    echo "   lib/: $LIB_DUP% (max ${DUP_THRESHOLD}%)"
    echo "   Run: jscpd --min-tokens 50 --min-lines 5 lib/"
    exit 1
  fi
else
  echo "⚠️  jscpd not found, skipping duplication check (npm install -g jscpd)"
fi

echo ""
echo "╔═══════════════════════════════════════════════════════════════════════════╗"
echo "║  ✅ ALL QUALITY GATES PASSED — COMMIT APPROVED                            ║"
echo "╚═══════════════════════════════════════════════════════════════════════════╝"
